# 11월20일에 생성한 같은 DB를 그대로 재사용합니다. DB 생성·seed 재실행 금지.
# 비밀번호에 @ 또는 : 문자가 있으면 URL encoding을 사용하세요.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/report_agent_lab
# 새 키를 발급받았다면 본인 계정의 활성 API Key를 사용하세요. Git 업로드 금지.
OPENAI_API_KEY=
# Tool Calling이 가능한 사용 가능 모델명을 직접 지정하십시오 (예: gpt-4.1-mini).
LLM_MODEL=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CUDA_DEVICE=cuda:0
MAX_TOOL_CALLS=4
MIN_COSINE_SIMILARITY=0.55
# 범위 제한은 서버가 구성한 앱 정책일 뿐 사용자 인증/소유권 ACL이 아닙니다.
ALLOWED_CATEGORIES=EXPERIMENT,DAILY_WORK,RESEARCH_PLAN,DATA_PROCESSING,PROMPT,MEETING
