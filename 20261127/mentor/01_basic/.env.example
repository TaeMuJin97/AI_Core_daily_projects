# Windows 11 / VS Code / Git Bash. 기존 실습의 실제 값을 입력하고 .env는 Git에 올리지 않는다.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/report_agent_lab
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVE_K=8
CONTEXT_K=3
MAX_TOOL_CALLS=4
MAX_MODEL_CALLS=14
LLM_TIMEOUT_SECONDS=30
CONTEXT_CHARS=9000
RERANK_BATCH_SIZE=2
RERANK_MAX_LENGTH=512
DB_TIMEOUT_MS=10000
# LangSmith 등 외부 tracing은 이 로컬 교육 프로젝트에 필요하지 않음.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# 점검용 ID 예시: pgAdmin에서 ready/유효 ID 및 실제 미존재 ID를 확인한 뒤 바꾼다.
# Git Bash export는 새 터미널에서 사라진다. .env에 저장하면 load_settings가 읽는다.
DAY30_REPORT_ID=63
DAY30_MISSING_ID=999999
